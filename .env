# ============================================================
# Ivory Brew Caffe - Environment Configuration
# ============================================================

# Aplikasi
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1

# Konfigurasi Database PostgreSQL
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ivory_brew_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_STORAGE=
DB_LOGGING=false

# Autentikasi JWT
JWT_SECRET=ivory_brew_super_secret_jwt_key_2026_xyz123!
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Keamanan & Rate Limiting
CORS_ORIGIN= http://localhost:5173,https://evacuee-annotate-dislike.ngrok-free.dev,http://localhost:5050,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000

# Pengaturan Bisnis
TAX_RATE=0.10

# Default Seeder Credentials
SEED_DEFAULT_PASSWORD=IvoryBrew123!
